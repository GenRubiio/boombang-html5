VITE_APP_ENV=local
VITE_SERVER_URL="http://localhost:3000"
VITE_SHOW_LOGS=false
VITE_MAP_MAKER=false
VITE_SHOW_ISOMAP=false
VITE_ANIMATION_AVATAR_EDITOR=false
VITE_WEB_TERMS_URL="http://127.0.0.1:8000"
VITE_RECAPTCHA_SITE_KEY=CHANGE_ME_RECAPTCHA_SITE_KEY
VITE_PERF_HARNESS=false
VITE_LAYERED_AVATARS=false
# design.md §9.2 (tasks.md slice 16): loads the base layered pack as one .bb bundle instead of
# 3 per-file requests. Requires `node scripts/bundle-avatar-packages.cjs <char>` to have run
# after `vite build` (dist/bundles/<char>.layers.bb must exist) — with this true but no bundle
# built, the base pack simply fails to load, same as any other missing-asset failure mode.
VITE_AVATAR_BUNDLES=false
# Gates client/src/harness/main.js (client/harness.html) — the dev-only Playwright
# resolved-state driving surface (avatar-system-multichar-fixes PR2). Never true outside
# `npm run test:e2e`'s webServer, which sets it directly; never part of the production build.
VITE_AVATAR_HARNESS=false
# Gates client/src/harness/realSceneMain.js (client/real-scene-harness.html) — tasks.md slice 21
# task 8's real-game-scene driving surface: boots the REAL PublicScene class (not the bespoke
# AvatarHarnessScene above), same two-level gate as VITE_AVATAR_HARNESS.
VITE_AVATAR_HARNESS_REAL_SCENE=false
VITE_AVATAR_LOOK_DEBUG=false
# Temporary dev/validation-only affordance (not part of any frozen spec) — forces every public
# scene to render at full daylight, skipping the day-night darkening overlay entirely. Does not
# touch the server's GameClock or any room's stored `darkening` data. Remove when no longer
# needed.
VITE_FORCE_DAYLIGHT=false